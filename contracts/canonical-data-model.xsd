<?xml version="1.0" encoding="UTF-8"?>
<!--
  Канонічна модель даних (SOA Canonical Data Model) для e-commerce платформи PrintZone.
  Єдине трактування ключових сутностей на все підприємство. ESB трансформує між цією
  канонічною моделлю та внутрішніми форматами окремих сервісів.
  Namespace версіюється: urn:printzone:soa:canonical:v1
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:cdm="urn:printzone:soa:canonical:v1"
            targetNamespace="urn:printzone:soa:canonical:v1"
            elementFormDefault="qualified"
            attributeFormDefault="unqualified">

  <!-- ============ Базові типи ============ -->

  <xsd:simpleType name="UUID">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="CurrencyCode">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[A-Z]{3}"/>  <!-- ISO 4217 -->
    </xsd:restriction>
  </xsd:simpleType>

  <!-- Гроші як ціле в мінорних одиницях (центах) + валюта -->
  <xsd:complexType name="Money">
    <xsd:sequence>
      <xsd:element name="amountMinor" type="xsd:long"/>
      <xsd:element name="currency" type="cdm:CurrencyCode"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="Address">
    <xsd:sequence>
      <xsd:element name="line1" type="xsd:string"/>
      <xsd:element name="line2" type="xsd:string" minOccurs="0"/>
      <xsd:element name="city" type="xsd:string"/>
      <xsd:element name="postalCode" type="xsd:string"/>
      <xsd:element name="country" type="xsd:string"/>  <!-- ISO 3166-1 alpha-2 -->
    </xsd:sequence>
  </xsd:complexType>

  <!-- ============ Клієнт ============ -->

  <xsd:complexType name="Customer">
    <xsd:sequence>
      <xsd:element name="id" type="cdm:UUID"/>
      <xsd:element name="email" type="xsd:string"/>
      <xsd:element name="fullName" type="xsd:string" minOccurs="0"/>
      <xsd:element name="address" type="cdm:Address" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <!-- ============ Товар ============ -->

  <xsd:complexType name="Product">
    <xsd:sequence>
      <xsd:element name="id" type="cdm:UUID"/>
      <xsd:element name="sku" type="xsd:string"/>
      <xsd:element name="name" type="xsd:string"/>
      <xsd:element name="price" type="cdm:Money"/>
      <xsd:element name="stockAvailable" type="xsd:int"/>
    </xsd:sequence>
  </xsd:complexType>

  <!-- ============ Замовлення ============ -->

  <xsd:simpleType name="OrderStatus">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="PENDING"/>
      <xsd:enumeration value="PAID"/>
      <xsd:enumeration value="PROCESSING"/>
      <xsd:enumeration value="SHIPPED"/>
      <xsd:enumeration value="DELIVERED"/>
      <xsd:enumeration value="CANCELLED"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:complexType name="OrderLine">
    <xsd:sequence>
      <xsd:element name="productId" type="cdm:UUID"/>
      <xsd:element name="sku" type="xsd:string"/>
      <xsd:element name="quantity" type="xsd:int"/>
      <xsd:element name="unitPrice" type="cdm:Money"/>
      <xsd:element name="lineTotal" type="cdm:Money"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="Order">
    <xsd:sequence>
      <xsd:element name="id" type="cdm:UUID"/>
      <xsd:element name="customerId" type="cdm:UUID"/>
      <xsd:element name="status" type="cdm:OrderStatus"/>
      <xsd:element name="line" type="cdm:OrderLine" maxOccurs="unbounded"/>
      <xsd:element name="total" type="cdm:Money"/>
      <xsd:element name="shippingAddress" type="cdm:Address"/>
      <xsd:element name="createdAt" type="xsd:dateTime"/>
    </xsd:sequence>
  </xsd:complexType>

  <!-- Кореневі елементи (для повторного використання у WSDL) -->
  <xsd:element name="customer" type="cdm:Customer"/>
  <xsd:element name="product" type="cdm:Product"/>
  <xsd:element name="order" type="cdm:Order"/>

</xsd:schema>
