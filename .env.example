# Приклад env для локального стека. Скопіюй у .env і за потреби зміни.

# Спільне
APP_ENV=dev
APP_SECRET=change_me_dev_secret

# Postgres (по одному екземпляру на stateful-сервіс)
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

# DSN сервісів (host = ім'я контейнера БД у compose-мережі)
CUSTOMER_DATABASE_URL=postgresql://app:changeme@db-customer:5432/customer?serverVersion=16&charset=utf8
PRODUCT_DATABASE_URL=postgresql://app:changeme@db-product:5432/product?serverVersion=16&charset=utf8
ORDER_DATABASE_URL=postgresql://app:changeme@db-order:5432/orders?serverVersion=16&charset=utf8
FULFILLMENT_DATABASE_URL=postgresql://app:changeme@db-fulfillment:5432/fulfillment?serverVersion=16&charset=utf8

# Шина / кеш
RABBITMQ_DSN=amqp://guest:guest@rabbitmq:5672/%2f
REDIS_DSN=redis://redis:6379

# Централізований IAM — ключ підпису токенів (спільний секрет для перевірки в ESB)
IAM_TOKEN_SECRET=change_me_iam_secret

# Публічна адреса ESB: її ESB підставляє у WSDL, які віддає клієнтам
ESB_PUBLIC_ENDPOINT=http://localhost:8080/soap

# Зовнішні інтеграції Fulfillment/Notification (fake за замовчуванням)
PAYMENT_PROVIDER=fake
SHIPPING_PROVIDER=fake
NOTIFICATION_GATEWAY=fake

# Креди реальних провайдерів (порожні = працюють лише fake-реалізації)
STRIPE_SECRET_KEY=
NOVAPOSHTA_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_DEFAULT_REGION=

# Куди слати лист, якщо подія не несе адреси отримувача
NOTIFICATION_FALLBACK_EMAIL=ops@printzone.local
