{
    "name": "printzone-soa/notification",
    "description": "SOA service (Task 28) — Notification (stateless email utility)",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-amqp": "*",
        "ext-json": "*",
        "ext-soap": "*",
        "symfony/cache": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
